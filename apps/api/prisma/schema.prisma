datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum ProfileType {
  personal
  business
}

enum Role {
  USER
  BUSINESS
  ADMIN
}

enum RelationshipStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model User {
  id           String      @id @default(uuid())
  name         String      @db.VarChar(100)
  email        String      @unique @db.VarChar(255)
  passwordHash String      @db.VarChar(255)
  profileType  ProfileType @default(personal)
  isVerified   Boolean     @default(true)
  avatar       String?     @db.VarChar(500)
  coverImage   String?     @db.VarChar(500)
  bio          String?     @db.Text
  role         Role        @default(USER)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  sentMessages Message[] @relation("SentMessages")
  receivedMessages Message[] @relation("ReceivedMessages")

  sentFriendRequests     Friendship[] @relation("SentFriendships")
  receivedFriendRequests Friendship[] @relation("ReceivedFriendships")
  posts                  Post[]       @relation("UserPosts")
  products               Product[]    @relation("UserProducts")
  notificationsReceived  Notification[] @relation("UserNotifications")
  notificationsTriggered Notification[] @relation("ActorNotifications")
  dailyAccesses          DailyUserAccess[]

  @@index([name])
  @@index([email])
  @@map("users")
}

model DailyUserAccess {
  id           String      @id @default(uuid())
  userId       String
  day          DateTime    @db.Date
  profileType  ProfileType
  loginCount   Int         @default(1)
  lastLoginAt  DateTime    @default(now()) @db.Timestamptz(3)
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, day])
  @@index([day, profileType])
  @@map("daily_user_accesses")
}

model Friendship {
  id          String             @id @default(uuid())
  requesterId String
  addresseeId String
  status      RelationshipStatus @default(PENDING)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  requester   User               @relation("SentFriendships", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee   User               @relation("ReceivedFriendships", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@unique([requesterId, addresseeId])
  @@map("friendships")
}

model Post {
  id           String   @id @default(uuid())
  authorId     String
  authorHandle String   @db.VarChar(100)
  authorAvatar String?  @db.VarChar(500)
  isVerified   Boolean  @default(false)
  location     String?  @db.VarChar(200)
  content      String   @db.Text
  category     String   @default("following") @db.VarChar(50)
  tags         String[] @default([])
  mediaUrl     String?  @db.VarChar(500)
  productName  String?  @db.VarChar(200)
  productPrice Float?
  productBadge String?  @db.VarChar(50)
  productStock String?  @db.VarChar(100)
  productDetails String? @db.Text
  productImage String?  @db.VarChar(500)
  likes        Int      @default(0)
  liked        Boolean  @default(false)
  bookmarked   Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  author       User     @relation("UserPosts", fields: [authorId], references: [id], onDelete: Cascade)
  comments     Comment[]

  @@index([authorId])
  @@index([category])
  @@map("posts")
}

model Comment {
  id           String   @id @default(uuid())
  postId       String
  authorId     String?
  author       String   @db.VarChar(100)
  authorAvatar String?  @db.VarChar(500)
  isVerified   Boolean  @default(false)
  text         String   @db.Text
  createdAt    DateTime @default(now())

  post         Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@index([authorId])
  @@map("comments")
}

model Notification {
  id           String   @id @default(uuid())
  userId       String
  actorId      String
  type         String   @db.VarChar(50)
  message      String   @db.Text
  read         Boolean  @default(false)
  friendshipId String?
  createdAt    DateTime @default(now())

  user         User     @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
  actor        User     @relation("ActorNotifications", fields: [actorId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("notifications")
}

model Product {
  id           String   @id @default(uuid())
  name         String   @db.VarChar(200)
  description  String   @db.Text
  price         Float
  category     String   @db.VarChar(100)
  district     String   @db.VarChar(100)
  store        String   @db.VarChar(200)
  sellerId     String
  isVerified   Boolean  @default(false)
  status       String   @default("Disponible") @db.VarChar(50)
  image        String?  @db.VarChar(500)
  contactPhone String?  @db.VarChar(20)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  seller       User     @relation("UserProducts", fields: [sellerId], references: [id], onDelete: Cascade)

  @@index([sellerId])
  @@index([category])
  @@index([district])
  @@index([status])
  @@map("products")
}

model Message {
  id String @id @default(uuid())
  senderId String
  recipientId String
  text String @db.Text
  clientMessageId String? @db.VarChar(100)
  productId String?
  productName String? @db.VarChar(200)
  productImage String? @db.VarChar(500)
  read Boolean @default(false)
  createdAt DateTime @default(now())
  sender User @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  recipient User @relation("ReceivedMessages", fields: [recipientId], references: [id], onDelete: Cascade)

  @@unique([senderId, clientMessageId])
  @@index([senderId, recipientId, createdAt])
  @@index([recipientId, createdAt])
  @@map("messages")
}
