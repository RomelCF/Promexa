# ========================================================
# Promexa - General Environment Variables
# ========================================================
NODE_ENV=development

# --------------------------------------------------------
# 1. PostgreSQL (Transactional Data)
# --------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=promexa_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_password
DATABASE_URL=postgresql://postgres:postgres_secure_password@localhost:5432/promexa_db?schema=public

# --------------------------------------------------------
# 2. Neo4j (Graph Database - Social Graph & Relationships)
# --------------------------------------------------------
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j_secure_password

# --------------------------------------------------------
# 3. Redis (Cache, Sessions & WebSocket broker)
# --------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_secure_password
REDIS_URL=redis://:redis_secure_password@localhost:6379

# --------------------------------------------------------
# 4. Amazon S3 (Object Storage - Multimedia Assets)
# --------------------------------------------------------
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_S3_BUCKET_NAME=promexa-media-bucket
AWS_S3_ENDPOINT= # Optional (e.g., for MinIO or LocalStack in dev)

# --------------------------------------------------------
# 5. NestJS Backend (API REST & WebSockets)
# --------------------------------------------------------
API_PORT=3001
JWT_SECRET=super_secret_jwt_key_promexa_2026
JWT_EXPIRATION=7d
CORS_ORIGIN=http://localhost:3000
DEFAULT_AVATAR_URL=https://lh3.googleusercontent.com/aida-public/AB6AXuAH3UDaH5S4ho_6H4oKGGbzvRDc6LorHWo-1pfiUJf12W1Auj4lfoQJv49kAmTodxRQ2qjn9Gw3OCKEgNjPAaYs7bWaSTa1ib_zIwwkI7_Q-YO8vrIQcqc93EcFCKTlM8e8icVlD5kHDDY2RToEXmganGu3acS1w16yAXHMOQI9YlC8xg_qHtttlbMKoseK0hFBvd51mYVAjPwV2omGzRF7l9YtdZHuawkgmcCUf4Q

# --------------------------------------------------------
# 6. Next.js Frontend
# --------------------------------------------------------
PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:3001

# --------------------------------------------------------
# 7. ML Recommendation Service (Python)
# --------------------------------------------------------
ML_SERVICE_PORT=8000
ML_SERVICE_URL=http://localhost:8000
ML_INTERNAL_API_KEY=internal_ml_service_token

# Image uploads: local for development, s3 for AWS or MinIO
STORAGE_DRIVER=local
PUBLIC_API_URL=http://localhost:3001/api/v1

# Enable only when Redis is configured. Required for multiple API instances.
REDIS_WS_ENABLED=false
